---
import Text from './Text.astro';
import { USE_CONFIDENTIAL_FALLBACKS } from '../data/site';

interface Stat {
  value: string;
  label: string;
  note?: string;
  fallback?: string;
  pending?: boolean;
}

interface Props {
  stats?: Stat[];
  compact?: boolean;
}

const { stats = [], compact = false } = Astro.props;

const shown = stats.flatMap((stat) => {
  const fallback = stat.fallback?.trim();
  if (stat.pending) return [];
  const usingFallback = USE_CONFIDENTIAL_FALLBACKS && Boolean(fallback);
  return [{
    text: usingFallback ? fallback! : stat.value,
    label: stat.label,
    note: stat.note,
    pending: false,
  }];
});
---
{shown.length > 0 && (
  <ol class:list={['stat-strip', { compact }]}>
    {shown.map((stat) => (
      <li>
        <span class="stat-value">
          <Text text={stat.text} pending={stat.pending} />
        </span>
        <span class="stat-label">{stat.label}</span>
        {stat.note && <span class="stat-note">{stat.note}</span>}
      </li>
    ))}
  </ol>
)}
