---
import Mark from './Mark.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const here = path === base ? '/' : path;
const home = here === '/' || here === '';

function current(href: string) {
  const full = url(href).replace(/\/$/, '') || '/';
  if (href === '/') return home;
  return here === full || here.startsWith(`${full}/`);
}

const links = [
  { href: '/work', label: 'work' },
  { href: '/#notes', label: 'notes' },
  { href: '/writing', label: 'writing' },
  { href: '/life', label: 'life' },
  { href: site.resumePath, label: 'resume' },
  { href: site.linkedin, label: 'linkedin', external: true },
  { href: `mailto:${site.email}`, label: 'email' },
];
---
<a class="skip" href="#content">Skip to content</a>
<header class:list={['top', home && 'is-home']}>
  {home ? (
    <h1 class="name"><a href={url('/')}>{site.masthead}</a></h1>
  ) : (
    <div class="hello">
      <Mark />
      <p class="name"><a href={url('/')}>{site.masthead}</a></p>
    </div>
  )}
  {home && <p class="bio">{site.greeting}</p>}
  {home && <Mark priority />}
  {home && (
    <section class="tracks" aria-label="Building, working, and doing">
      {site.direction.map((group) => (
        <div class="track">
          <h2 class="track-label">{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                {item.map((piece) =>
                  piece.href ? <a href={url(piece.href)}>{piece.text}</a> : <span>{piece.text}</span>,
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}
  <nav class="nav" aria-label="Primary">
    {links.map((link) => (
      <a
        href={url(link.href)}
        aria-current={!link.external && !link.href.startsWith('/#') && current(link.href) ? 'page' : undefined}
        {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {link.label}
        {link.external && <span class="vh"> (opens in a new tab)</span>}
      </a>
    ))}
  </nav>
</header>
