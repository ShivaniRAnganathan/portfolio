---
/**
 * Pixel monogram. Abstract on purpose: a chunky grid, not a drawn letter.
 * Do not generate a portrait.
 */
---
<div class="mark">
  <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
    <rect width="16" height="16" fill="#fff" />
    <g fill="#111">
      <rect x="2" y="1" width="2" height="2" />
      <rect x="7" y="2" width="2" height="2" />
      <rect x="12" y="1" width="2" height="2" />
      <rect x="1" y="5" width="2" height="2" />
      <rect x="6" y="5" width="2" height="2" />
      <rect x="11" y="6" width="2" height="2" />
      <rect x="4" y="8" width="2" height="2" />
      <rect x="9" y="9" width="2" height="2" />
      <rect x="2" y="11" width="2" height="2" />
      <rect x="8" y="12" width="2" height="2" />
      <rect x="13" y="11" width="2" height="2" />
    </g>
  </svg>
</div>
