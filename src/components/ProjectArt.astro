---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
<svg class="project-art" viewBox="0 0 80 60" shape-rendering="crispEdges" aria-hidden="true">
  {slug === 'carnatic-raga-identifier' && (
    <>
      <rect width="80" height="60" fill="#fff" />
      <rect x="8" y="18" width="64" height="1" fill="#111" />
      <rect x="8" y="26" width="64" height="1" fill="#111" />
      <rect x="8" y="34" width="64" height="1" fill="#111" />
      <rect x="8" y="42" width="64" height="1" fill="#111" />
      <rect x="18" y="22" width="3" height="3" fill="#111" />
      <rect x="20" y="10" width="1" height="14" fill="#111" />
      <rect x="34" y="30" width="3" height="3" fill="#111" />
      <rect x="36" y="14" width="1" height="18" fill="#111" />
      <rect x="50" y="22" width="3" height="3" fill="#111" />
      <rect x="52" y="8" width="1" height="16" fill="#111" />
      <rect x="62" y="38" width="3" height="3" fill="#111" />
      <rect x="64" y="24" width="1" height="16" fill="#111" />
    </>
  )}
  {slug === 'hinge-harmonium' && (
    <>
      <rect width="80" height="60" fill="#fff" />
      <rect x="14" y="16" width="28" height="2" fill="#111" />
      <rect x="14" y="18" width="2" height="22" fill="#111" />
      <rect x="40" y="18" width="2" height="22" fill="#111" />
      <rect x="14" y="38" width="28" height="2" fill="#111" />
      <rect x="18" y="22" width="20" height="1" fill="#111" />
      <rect x="18" y="26" width="20" height="1" fill="#111" />
      <rect x="18" y="30" width="20" height="1" fill="#111" />
      <rect x="18" y="34" width="20" height="1" fill="#111" />
      <rect x="44" y="20" width="22" height="16" fill="#fff" stroke="#111" stroke-width="1" />
      <rect x="48" y="24" width="14" height="8" fill="#111" />
      <rect x="41" y="16" width="2" height="4" fill="#111" />
    </>
  )}
  {slug === 'coffee-table-book' && (
    <>
      <rect width="80" height="60" fill="#fff" />
      <rect x="10" y="12" width="28" height="36" fill="#fff" stroke="#111" stroke-width="1" />
      <rect x="42" y="12" width="28" height="36" fill="#fff" stroke="#111" stroke-width="1" />
      <rect x="38" y="12" width="4" height="36" fill="#111" />
      <rect x="14" y="16" width="10" height="8" fill="#111" />
      <rect x="26" y="16" width="8" height="8" fill="#111" />
      <rect x="14" y="26" width="20" height="6" fill="#111" />
      <rect x="14" y="34" width="12" height="8" fill="#111" />
      <rect x="46" y="16" width="20" height="14" fill="#111" />
      <rect x="46" y="32" width="8" height="8" fill="#111" />
      <rect x="56" y="32" width="10" height="8" fill="#111" />
    </>
  )}
</svg>
