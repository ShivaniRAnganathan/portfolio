---
import Base from '../layouts/Base.astro';
import DeskMark from '../components/DeskMark.astro';
import StatusPill from '../components/StatusPill.astro';
import { getCollection } from 'astro:content';

type DeskStatus = 'Planned' | 'In progress';
type DeskCard = {
  title: string;
  status: DeskStatus;
  letter: string;
  motif: 'grid' | 'dots' | 'bars';
  description?: string;
};

const dispatches = (await getCollection('ai'))
  .filter((entry) => entry.id !== 'how-i-build' && entry.id !== 'automating-recurring-tasks')
  .sort((a, b) => a.data.order - b.data.order);

const tiles: DeskCard[] = [
  {
    title: 'Hingemonium',
    status: 'In progress',
    letter: 'H',
    motif: 'grid',
    description:
      'A harmonium you play with your laptop. Opening and closing the lid pumps the bellows, and the keyboard plays the notes, so the hinge does the job the hand-pumped bellows do on the real instrument.',
  },
  {
    title: 'Coffee table book',
    status: 'In progress',
    letter: 'C',
    motif: 'bars',
    description:
      'Give it a folder of photos and it lays them out as a printable coffee table book. It groups the photos, picks page layouts, and exports a print-ready file.',
  },
  {
    title: 'Carnatic music identifier',
    status: 'In progress',
    letter: 'C',
    motif: 'dots',
    description:
      'Manodharma is the improvised part of a Carnatic performance, where the musician explores a raga freely instead of playing a fixed composition. This project listens to a recording of that improvisation and suggests which raga it is, from the notes being used and how the phrases move between them.',
  },
];

const noteLines: Record<string, string> = {
  'organising-my-work': 'Assistants keep my existing work organised and optimised.',
  'writing-tickets-and-specs': 'Assistants help me draft tickets and specs.',
  'streamlining-workflows': 'Assistants help my workflows run more efficiently.',
};

---
<Base title="AI Desk" description="AI Desk.">
  <div class="page">
    <p class="kicker">AI Desk</p>
    <h1 class="page-title">Dispatches</h1>
    <ul class="desk-grid">
      {tiles.map((card) => (
        <li class="desk-card">
          <DeskMark letter={card.letter} motif={card.motif} />
          <h2>{card.title}</h2>
          {card.description ? <p class="desk-desc">{card.description}</p> : null}
          <p class="desk-status"><StatusPill status={card.status} /></p>
        </li>
      ))}
    </ul>
    <ol class="dispatch-list">
      {dispatches.map((entry) => (
        <li id={entry.id}>
          <h2>{entry.data.title}</h2>
          <p class="desk-note">{noteLines[entry.id]}</p>
        </li>
      ))}
    </ol>
  </div>
</Base>
