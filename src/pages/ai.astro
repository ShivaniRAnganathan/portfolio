---
import Base from '../layouts/Base.astro';
import DeskMark from '../components/DeskMark.astro';
import StatusPill from '../components/StatusPill.astro';
import Text from '../components/Text.astro';
import { cleanContent } from '../lib/content';
import { hasUnapprovedFigure } from '../lib/copy';
import { getCollection } from 'astro:content';

type DeskStatus = 'Planned' | 'In progress';
type DeskCard = {
  title: string;
  status: DeskStatus;
  letter: string;
  motif: 'grid' | 'dots' | 'bars';
  description?: string;
};

type Note = { text: string; pending?: boolean };

function notes(value?: Note | Note[]): Note[] {
  if (!value) return [];
  const list = Array.isArray(value) ? value : [value];
  return list
    .map((line) => {
    const cleaned = cleanContent(line.text);
    if ((line.pending || cleaned.pending) && hasUnapprovedFigure(cleaned.text)) return null;
    return { text: cleaned.text, pending: false };
  })
  .filter((line): line is Note => line !== null && line.text.length > 0);
}

const dispatches = (await getCollection('ai'))
  .filter((entry) => entry.id !== 'how-i-build' && entry.id !== 'automating-recurring-tasks')
  .sort((a, b) => a.data.order - b.data.order);

const tiles: DeskCard[] = [
  { title: 'Hingemonium', status: 'In progress', letter: 'H', motif: 'grid' },
  { title: 'Coffee table book', status: 'In progress', letter: 'C', motif: 'bars' },
  { title: 'Carnatic music identifier', status: 'In progress', letter: 'C', motif: 'dots' },
];

const fields = [
  ['problem', 'Problem'],
  ['principles', 'First principles'],
  ['system', 'The system'],
  ['stillDecide', 'What I still decide'],
  ['outcome', 'Outcome'],
  ['next', "What's next"],
] as const;
---
<Base title="AI Desk" description="AI Desk.">
  <div class="page">
    <p class="kicker">AI Desk</p>
    <h1 class="page-title">Dispatches</h1>
    <ul class="desk-grid">
      {tiles.map((card) => (
        <li class="desk-card">
          <DeskMark letter={card.letter} motif={card.motif} />
          <h2>{card.title}</h2>
          <p class="desk-status"><StatusPill status={card.status} /></p>
          {card.description ? <p class="desk-desc">{card.description}</p> : null}
        </li>
      ))}
    </ul>
    <ol class="dispatch-list">
      {dispatches.map((entry) => {
        const data = entry.data;
        const filled = fields.some(([key]) => notes(data[key]).length > 0);
        return (
          <li id={entry.id}>
            <h2>{data.title}</h2>
            {(data.date || data.autonomy) && (
              <p class="writing-meta">
                {[data.date, data.autonomy].filter(Boolean).join(' · ')}
              </p>
            )}
            {filled ? (
              <dl class="dispatch-fields">
                {fields.map(([key, label]) => {
                  const lines = notes(data[key]);
                  if (lines.length === 0) return null;
                  return (
                    <div>
                      <dt>{label}</dt>
                      <dd>
                        {lines.map((line) => (
                          <p>
                            <Text text={line.text} pending={line.pending} />
                          </p>
                        ))}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            ) : (
              <p class="filed">Filed soon.</p>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</Base>
