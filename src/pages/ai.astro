---
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import { cleanContent } from '../lib/content';
import { getCollection } from 'astro:content';

type Note = { text: string; pending?: boolean };

function notes(value?: Note | Note[]): Note[] {
  if (!value) return [];
  const list = Array.isArray(value) ? value : [value];
  return list
    .map((line) => {
      const cleaned = cleanContent(line.text);
      return { text: cleaned.text, pending: Boolean(line.pending) || cleaned.pending };
    })
    .filter((line) => line.text.length > 0);
}

const dispatches = (await getCollection('ai')).sort((a, b) => a.data.order - b.data.order);

const fields = [
  ['problem', 'Problem'],
  ['principles', 'First principles'],
  ['system', 'The system'],
  ['stillDecide', 'What I still decide'],
  ['outcome', 'Outcome'],
  ['next', "What's next"],
] as const;
---
<Base title="AI Desk" description="How I build with AI.">
  <div class="page">
    <p class="kicker">AI Desk</p>
    <h1 class="page-title">Dispatches</h1>
    <p class="deck">Each dispatch has the problem, a first-principles breakdown, the system, what I still decide, and the outcome.</p>
    <ol class="dispatch-list">
      {dispatches.map((entry) => {
        const data = entry.data;
        const filled = fields.some(([key]) => notes(data[key]).length > 0);
        return (
          <li id={entry.id}>
            <h2>{data.title}</h2>
            {(data.date || data.autonomy) && (
              <p class="writing-meta">
                {[data.date, data.autonomy].filter(Boolean).join(' · ')}
              </p>
            )}
            {filled ? (
              <dl class="dispatch-fields">
                {fields.map(([key, label]) => {
                  const lines = notes(data[key]);
                  if (lines.length === 0) return null;
                  return (
                    <div>
                      <dt>{label}</dt>
                      <dd>
                        {lines.map((line) => (
                          <p>
                            <Text text={line.text} pending={line.pending} />
                          </p>
                        ))}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            ) : (
              <p class="filed">Filed soon.</p>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</Base>
