---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Copy from '../../components/Copy.astro';
import Text from '../../components/Text.astro';
import { caseHeadline, visibleCopy } from '../../lib/copy';
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const index = studies.findIndex((entry) => entry.id === slug);
const entry = studies[index];
if (!entry) {
  throw new Error(`Missing case study: ${slug}`);
}

const prev = index > 0 ? studies[index - 1] : undefined;
const next = index < studies.length - 1 ? studies[index + 1] : undefined;
const outcome = caseHeadline(entry.data);
const scale = visibleCopy(entry.data.scale);
const description = `${entry.data.company}. ${entry.data.title}.`;
---
<Base title={entry.data.title} description={description}>
  <article class="page">
    <p class="back"><a href={url('/work')}>Work</a></p>
    <header class="opening">
      <p class="eyebrow">{entry.data.company}</p>
      <h1>
        <Text text={outcome.text} />
        {outcome.pending && <span class="badge">Unconfirmed</span>}
      </h1>
      <p class="case-name">{entry.data.title}</p>
      <p class="lede">{entry.data.dek}</p>
      <div class="summary">
        <dl>
          <div>
            <dt>Company</dt>
            <dd>{entry.data.company}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd><Text text={entry.data.role} /></dd>
          </div>
          <div>
            <dt>Timeline</dt>
            <dd><Text text={entry.data.timeline} /></dd>
          </div>
          {scale && (
            <div class="span">
              <dt>Scale</dt>
              <dd>
                <Text text={scale.text} />
                {scale.pending && <Badge />}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </header>

    {entry.data.sections.map((section) => {
      const paragraphs = (section.paragraphs ?? []).filter((paragraph) => visibleCopy(paragraph));
      const items = (section.items ?? []).filter((item) => visibleCopy(item));
      if (paragraphs.length === 0 && items.length === 0) return null;
      return (
        <section class="case-section">
          <h2>{section.heading}</h2>
          <div class="prose">
            {paragraphs.map((paragraph) => <Copy copy={paragraph} />)}
            {items.length > 0 && (
              <ul>
                {items.map((item) => (
                  <li>
                    <Copy copy={item} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      );
    })}

    <nav class="pager" aria-label="Other case studies">
      {prev ? (
        <a href={url(`/work/${prev.id}`)}>
          <span>Previous</span>
          <strong>{prev.data.title}</strong>
        </a>
      ) : <span></span>}
      {next && (
        <a class="next" href={url(`/work/${next.id}`)}>
          <span>Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  </article>
</Base>
