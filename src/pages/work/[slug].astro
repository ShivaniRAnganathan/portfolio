---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Copy from '../../components/Copy.astro';
import Text from '../../components/Text.astro';
import { caseParts, visibleCopy, type ResolvedCopy } from '../../lib/copy';
import { url } from '../../lib/url';
import type { Copy as CopyText } from '../../data/site';
import { getCollection } from 'astro:content';

type FactValue = string | CopyText | CopyText[];

function resolveFact(value: FactValue | undefined): ResolvedCopy[] {
  if (!value) return [];
  const list = typeof value === 'string' ? [{ primary: value }] : Array.isArray(value) ? value : [value];
  return list.flatMap((part) => {
    const resolved = visibleCopy(part);
    return resolved ? [resolved] : [];
  });
}

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const index = studies.findIndex((entry) => entry.id === slug);
const entry = studies[index];
if (!entry) {
  throw new Error(`Missing case study: ${slug}`);
}

const prev = index > 0 ? studies[index - 1] : undefined;
const next = index < studies.length - 1 ? studies[index + 1] : undefined;
const outcome = caseParts(entry.data);
const facts = [
  { label: 'Role', value: entry.data.role, wide: false },
  { label: 'Team', value: entry.data.team, wide: false },
  { label: 'Timeline', value: entry.data.timeline, wide: true },
  { label: 'Scale', value: entry.data.scale, wide: true },
  { label: 'Outcome', value: entry.data.outcome, wide: true },
].flatMap((fact) => {
  const parts = resolveFact(fact.value);
  return parts.length > 0 ? [{ ...fact, parts }] : [];
});
const description = `${entry.data.company}. ${entry.data.title}.`;
---
<Base title={entry.data.title} description={description}>
  <article class="page">
    <p class="back"><a href={url('/work')}>Work</a></p>
    <header class="opening">
      <p class="kicker">Case file · {entry.data.company}</p>
      <h1>
        {outcome.map((part) => (
          <span class="outcome-part">
            <Text text={part.text} />
            {part.pending && <span class="badge">Unconfirmed</span>}
          </span>
        ))}
      </h1>
      <p class="case-name">{entry.data.title}</p>
      <p class="lede">{entry.data.dek}</p>
      <div class="summary">
        <p class="fact-kicker">The facts</p>
        <dl>
          {facts.map((fact) => (
            <div class={fact.wide ? 'wide' : undefined}>
              <dt>{fact.label}</dt>
              <dd>
                {fact.parts.map((part) => (
                  <span class="fact-part">
                    <Text text={part.text} />
                    {part.pending && <Badge />}
                  </span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </header>

    {entry.data.sections.map((section) => {
      const paragraphs = (section.paragraphs ?? []).filter((paragraph) => visibleCopy(paragraph));
      const items = (section.items ?? []).filter((item) => visibleCopy(item));
      if (paragraphs.length === 0 && items.length === 0) return null;
      return (
        <section class="case-section">
          <h2>{section.heading}</h2>
          <div class="prose">
            {paragraphs.map((paragraph) => <Copy copy={paragraph} />)}
            {items.length > 0 && (
              <ul>
                {items.map((item) => (
                  <li>
                    <Copy copy={item} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      );
    })}

    <nav class="pager" aria-label="Other case studies">
      {prev ? (
        <a href={url(`/work/${prev.id}`)}>
          <span>Previous</span>
          <strong>{prev.data.title}</strong>
        </a>
      ) : <span></span>}
      {next && (
        <a class="next" href={url(`/work/${next.id}`)}>
          <span>Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  </article>
</Base>
