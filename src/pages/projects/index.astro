---
import Base from '../../layouts/Base.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { projects } from '../../data/projects';
import { url } from '../../lib/url';
---
<Base title="Projects" description="Side projects, still in progress.">
  <div class="page page-wide">
    <p class="back"><a href={url('/')}>← back to the notebook</a></p>
    <h1 class="page-title">Projects</h1>
    <p class="deck">Side projects, still in progress.</p>
    <ul class="project-grid">
      {projects.map((project) => (
        <li>
          <a class="project-card" href={url(`/projects/${project.slug}`)}>
            <ProjectArt slug={project.slug} />
            <span class="project-title">{project.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
