---
import Base from '../layouts/Base.astro';
import FeedNote from '../components/FeedNote.astro';
import { site } from '../data/site';
import { hasUnapprovedFigure, visibleCopy } from '../lib/copy';
import { cleanContent } from '../lib/content';
import { url } from '../lib/url';
import { getCollection } from 'astro:content';

type Para = { text: string; pending?: boolean };
type Card = {
  heading: string;
  tools?: string;
  paragraphs: Para[];
  link?: { href: string; label: string; external?: boolean };
};
type Kind = 'work' | 'ai' | 'writing' | 'life';
type NotebookDate = { day: string; year: string };
type Item = {
  sort: string;
  kind: Kind;
  date?: NotebookDate;
  title: string;
  paragraphs: Para[];
  aside?: string;
  href?: string;
  external?: boolean;
  id?: string;
  cards: Card[];
  more?: { href: string; label: string };
};

const months: Record<string, string> = {
  jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
  jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12',
};
const monthName = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

function writingDate(raw?: string) {
  if (!raw) return null;
  const match = raw.match(/^([A-Za-z]+)\s+(\d{1,2}),\s+(\d{4})$/);
  if (!match) return null;
  const mm = months[match[1].slice(0, 3).toLowerCase()];
  if (!mm) return null;
  const dd = match[2].padStart(2, '0');
  return {
    sort: `${match[3]}-${mm}-${dd}`,
    date: { day: `${monthName[Number(mm) - 1]} ${Number(match[2])}`, year: match[3] },
  };
}

/** Ship or launch dates taken from the case-study copy. No day is invented. */
const caseWhen: Record<string, { sort: string; date: NotebookDate }> = {
  'redemption-tax-exit-load': { sort: '2025-10-01', date: { day: 'oct', year: '2025' } },
  'wealth-spectrum-one-view': { sort: '2025-05-21', date: { day: 'may 21', year: '2025' } },
  'rm-dashboard': { sort: '2026-02-12', date: { day: 'feb 12', year: '2026' } },
  'voice-of-the-rm': { sort: '2026-08-12', date: { day: 'aug 12', year: '2026' } },
};

/** One line already in the source. No new claims. */
const asides: Record<string, string> = {
  'redemption-tax-exit-load': "Most people leaving don't need to sell.",
  'wealth-spectrum-one-view': 'For a wealth client, a wrong number costs more than a missing feature.',
  'rm-dashboard': 'Time in the dashboard is only a proxy.',
  'voice-of-the-rm': 'I started a monthly Private Wealth newsletter to close the loop.',
  'ketto-bulk-donation': 'Every extra step between "I want to help" and "done" costs money.',
  'ketto-recurring-donations': 'A donor can set a monthly amount once, instead of being asked again for every campaign.',
  humidity: 'Now, I admire the people who stay kind when the weather is not.',
  'fifteen-minutes': 'The stool still wobbled.',
  'tongue-tied': 'I spoke less, but I meant more.',
  'its-really-salty': 'Presence matters more than perfection.',
  'the-snore': 'Because sound is slippery. It doesn’t stay.',
  'finding-my-voice': 'I was an echo, not a voice.',
  scenius: 'Move over, lone wolf product managers!',
  'chapter-2': 'I pretended I didn’t know what crowdfunding was.',
  'checklist-prds': 'The checklist PRD let us pivot much more quickly based on user feedback.',
};

function toolsIn(text: string) {
  const catalog: [string, RegExp][] = [
    ['email', /\bemail\b/i],
    ['calendar', /\bcalendar\b/i],
    ['Notion', /Notion/],
    ['GitHub', /GitHub/],
    ['Claude', /Claude/],
  ];
  const found = catalog.flatMap(([name, pattern]) => (pattern.test(text) ? [name] : []));
  return found.length > 0 ? found.join(' + ') : undefined;
}

function statParagraphs(stats: { value: string; label: string; note?: string; fallback?: string; pending?: boolean }[] | undefined): Para[] {
  return (stats ?? []).flatMap((stat) => {
    if (stat.pending) return [];
    const note = stat.note ? ` ${stat.note}` : '';
    const label = stat.label.charAt(0).toLowerCase() + stat.label.slice(1);
    return [{ text: `${stat.value} ${label}.${note}` }];
  });
}

type AiNote = { text: string; pending?: boolean };
function aiLines(value?: AiNote | AiNote[]): Para[] {
  if (!value) return [];
  const list = Array.isArray(value) ? value : [value];
  return list.flatMap((line) => {
    const cleaned = cleanContent(line.text);
    if (!cleaned.text) return [];
    if ((line.pending || cleaned.pending) && hasUnapprovedFigure(cleaned.text)) return [];
    return [{ text: cleaned.text }];
  });
}

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const featured = studies.filter((entry) => entry.data.featured);
const writing = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const ai = (await getCollection('ai')).sort((a, b) => a.data.order - b.data.order);
const builder = ai.find((entry) => entry.id === 'how-i-build');

const aiPremise = builder ? aiLines(builder.data.problem)[0]?.text : '';
const aiTools = builder
  ? toolsIn(aiLines(builder.data.system).map((line) => line.text).join(' '))
  : undefined;

const items: Item[] = [];

for (const entry of studies) {
  const when = caseWhen[entry.id];
  const stats = statParagraphs(entry.data.stats);
  items.push({
    sort: when?.sort ?? `0001-${String(100 - entry.data.order).padStart(2, '0')}`,
    kind: 'work',
    date: when?.date,
    title: entry.data.headline,
    aside: asides[entry.id],
    paragraphs: [{ text: entry.data.dek }],
    cards: [
      {
        heading: entry.data.title,
        paragraphs: stats,
        link: { href: url(`/work/${entry.id}`), label: 'Read the case study' },
      },
    ],
  });
}

for (const entry of writing) {
  const when = writingDate(entry.data.date);
  const metric = entry.data.metric ? visibleCopy(entry.data.metric) : undefined;
  const paragraphs: Para[] = [{ text: entry.data.summary }];
  if (metric) paragraphs.push(metric);
  items.push({
    sort: when?.sort ?? `0002-${String(100 - entry.data.order).padStart(2, '0')}`,
    kind: 'writing',
    date: when?.date,
    title: entry.data.title,
    aside: asides[entry.id],
    href: entry.data.href,
    external: true,
    paragraphs,
    cards: [],
  });
}

for (const slot of site.life) {
  const started = slot.id === 'roll-and-wear';
  items.push({
    sort: started ? '2024-07-01' : `0003-${slot.id}`,
    kind: 'life',
    date: started ? { day: 'jul', year: '2024' } : undefined,
    title: slot.title,
    paragraphs: slot.paragraphs.map((text) => ({ text })),
    href: url('/life'),
    cards: [],
  });
}

items.sort((a, b) => (a.sort < b.sort ? 1 : a.sort > b.sort ? -1 : 0));
---
<Base description={site.hook}>
  <div class="page">
    {builder && aiPremise && (
      <section class="ai-feature" aria-labelledby="ai-feature-heading">
        <p class="note-meta">
          <span class="pill pill-ai"><span class="glyph" aria-hidden="true">✶</span>ai</span>
        </p>
        <h2 id="ai-feature-heading">{builder.data.title}</h2>
        <p>{aiPremise}</p>
        {aiTools && <p class="tools">{aiTools}</p>}
        <p class="more"><a href={url('/ai')}>read more</a></p>
      </section>
    )}
    <section class="selected" aria-labelledby="selected-heading">
      <h2 id="selected-heading">Selected work</h2>
      <ul>
        {featured.map((entry) => (
          <li>
            <a href={url(`/work/${entry.id}`)}>{entry.data.headline}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="notes" id="notes" aria-label="Notes">
      {items.map((item) => (
        <FeedNote
          kind={item.kind}
          date={item.date}
          title={item.title}
          paragraphs={item.paragraphs}
          aside={item.aside}
          href={item.href}
          external={item.external}
          id={item.id}
          cards={item.cards}
          more={item.more}
        />
      ))}
    </section>
  </div>
</Base>
