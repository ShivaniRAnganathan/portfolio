---
import Base from '../layouts/Base.astro';
import FeedNote from '../components/FeedNote.astro';
import { site, SHOW_PENDING_BADGES, USE_CONFIDENTIAL_FALLBACKS } from '../data/site';
import { countsAsPendingFigure, visibleCopy } from '../lib/copy';
import { cleanContent } from '../lib/content';
import { url } from '../lib/url';
import { getCollection } from 'astro:content';

type Para = { text: string; pending?: boolean };
type Card = {
  heading: string;
  tools?: string;
  paragraphs: Para[];
  link?: { href: string; label: string; external?: boolean };
};
type Item = {
  sort: string;
  date?: string;
  title: string;
  paragraphs: Para[];
  href?: string;
  external?: boolean;
  id?: string;
  cards: Card[];
  more?: { href: string; label: string };
};

const months: Record<string, string> = {
  jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
  jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12',
};

function writingDate(raw?: string) {
  if (!raw) return null;
  const match = raw.match(/^([A-Za-z]+)\s+(\d{1,2}),\s+(\d{4})$/);
  if (!match) return null;
  const mm = months[match[1].slice(0, 3).toLowerCase()];
  if (!mm) return null;
  const dd = match[2].padStart(2, '0');
  return { sort: `${match[3]}-${mm}-${dd}`, date: `${mm}.${dd} ${match[3]}` };
}

/** Ship or launch dates taken from the case-study copy. No day is invented. */
const caseWhen: Record<string, { sort: string; date: string }> = {
  'redemption-tax-exit-load': { sort: '2025-10-01', date: '10 2025' },
  'wealth-spectrum-one-view': { sort: '2025-05-21', date: '05.21 2025' },
  'rm-dashboard': { sort: '2026-02-12', date: '02.12 2026' },
  'voice-of-the-rm': { sort: '2026-08-12', date: '08.12 2026' },
};

function toolsIn(text: string) {
  const catalog: [string, RegExp][] = [
    ['email', /\bemail\b/i],
    ['calendar', /\bcalendar\b/i],
    ['Notion', /Notion/],
    ['GitHub', /GitHub/],
    ['Claude', /Claude/],
  ];
  const found = catalog.flatMap(([name, pattern]) => (pattern.test(text) ? [name] : []));
  return found.length > 0 ? found.join(' + ') : undefined;
}

function statParagraphs(stats: { value: string; label: string; note?: string; fallback?: string; pending?: boolean }[] | undefined): Para[] {
  return (stats ?? []).map((stat) => {
    const fallback = stat.fallback?.trim();
    const usingFallback = USE_CONFIDENTIAL_FALLBACKS && Boolean(fallback);
    const label = stat.label.charAt(0).toLowerCase() + stat.label.slice(1);
    const text = usingFallback ? `${fallback}.` : `${stat.value} ${label}.`;
    const pending = !usingFallback && SHOW_PENDING_BADGES && Boolean(stat.pending);
    const note = stat.note ? ` ${stat.note}` : '';
    return { text: `${text}${note}`, pending };
  });
}

type AiNote = { text: string; pending?: boolean };
function aiLines(value?: AiNote | AiNote[]): Para[] {
  if (!value) return [];
  const list = Array.isArray(value) ? value : [value];
  return list.flatMap((line) => {
    const cleaned = cleanContent(line.text);
    if (!cleaned.text) return [];
    return [{ text: cleaned.text, pending: Boolean(line.pending) || cleaned.pending }];
  });
}

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const featured = studies.filter((entry) => entry.data.featured);
const writing = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const ai = (await getCollection('ai')).sort((a, b) => a.data.order - b.data.order);
const builder = ai.find((entry) => entry.id === 'how-i-build');

const items: Item[] = [];

if (builder) {
  const data = builder.data;
  const problem = aiLines(data.problem);
  const principles = aiLines(data.principles);
  const system = aiLines(data.system);
  const outcome = aiLines(data.outcome);
  const next = aiLines(data.next);
  const cards: Card[] = [
    { heading: 'How I broke it down', paragraphs: principles },
    { heading: 'The system', tools: toolsIn(system.map((line) => line.text).join(' ')), paragraphs: system },
    { heading: 'Outcome', paragraphs: outcome },
    { heading: "What's next", paragraphs: next },
  ].filter((card) => card.paragraphs.length > 0);
  items.push({
    sort: '9999-01-01',
    title: data.title,
    paragraphs: problem,
    id: builder.id,
    cards,
    more: { href: url('/ai'), label: 'All dispatches' },
  });
}

for (const entry of studies) {
  const when = caseWhen[entry.id];
  const stats = statParagraphs(entry.data.stats);
  items.push({
    sort: when?.sort ?? `0001-${String(100 - entry.data.order).padStart(2, '0')}`,
    date: when?.date,
    title: entry.data.headline,
    paragraphs: [{ text: entry.data.dek }],
    cards: [
      {
        heading: entry.data.title,
        paragraphs: stats,
        link: { href: url(`/work/${entry.id}`), label: 'Read the case study' },
      },
    ],
  });
}

for (const entry of writing) {
  const when = writingDate(entry.data.date);
  const metric = entry.data.metric ? visibleCopy(entry.data.metric) : undefined;
  const paragraphs: Para[] = [{ text: entry.data.summary }];
  if (metric) paragraphs.push(metric);
  items.push({
    sort: when?.sort ?? `0002-${String(100 - entry.data.order).padStart(2, '0')}`,
    date: when?.date,
    title: entry.data.title,
    href: entry.data.href,
    external: true,
    paragraphs,
    cards: [],
  });
}

for (const slot of site.life) {
  const started = slot.id === 'roll-and-wear';
  items.push({
    sort: started ? '2024-07-01' : `0003-${slot.id}`,
    date: started ? '07 2024' : undefined,
    title: slot.title,
    paragraphs: slot.paragraphs.map((text) => ({ text })),
    href: url('/life'),
    cards: [],
  });
}

items.sort((a, b) => (a.sort < b.sort ? 1 : a.sort > b.sort ? -1 : 0));

let pendingFigures = 0;
const tally = (text: string, pending?: boolean) => {
  if (countsAsPendingFigure(text, Boolean(pending))) pendingFigures += 1;
};
for (const item of items) {
  for (const paragraph of item.paragraphs) tally(paragraph.text, paragraph.pending);
  for (const card of item.cards) {
    for (const paragraph of card.paragraphs) tally(paragraph.text, paragraph.pending);
  }
}
---
<Base description={site.hook}>
  <div class="page">
    <section class="selected" aria-labelledby="selected-heading">
      <h2 id="selected-heading">Selected work</h2>
      <ul>
        {featured.map((entry) => (
          <li>
            <a href={url(`/work/${entry.id}`)}>{entry.data.headline}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="notes" id="notes" aria-label="Notes">
      {pendingFigures >= 3 && (
        <p class="editors-note">Editor's note. Dotted underlines mark figures not yet approved for publishing.</p>
      )}
      {items.map((item) => (
        <FeedNote
          date={item.date}
          title={item.title}
          paragraphs={item.paragraphs}
          href={item.href}
          external={item.external}
          id={item.id}
          cards={item.cards}
          more={item.more}
        />
      ))}
    </section>
  </div>
</Base>
