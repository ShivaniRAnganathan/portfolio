---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import WorkRow from '../components/WorkRow.astro';
import { site } from '../data/site';
import { caseHeadline, visibleCopy } from '../lib/copy';
import { url } from '../lib/url';
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const dispatches = (await getCollection('ai')).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);

const index = (n: number) => String(n + 1).padStart(2, '0');
const [brand, ...otherLife] = site.life;
---
<Base description={site.hook}>
  <div class="page front">
    <section class="lead" aria-labelledby="hook">
      <h1 id="hook">{site.hook}</h1>
      <nav class="edition-strip" aria-label="In this edition">
        <p class="kicker">In this edition</p>
        <ol>
          <li><a href="#case-files">Case files</a></li>
          <li><a href="#ai-desk">AI Desk</a></li>
        </ol>
      </nav>
    </section>

    <section class="block" id="case-files" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading" class="section-label">Case files</h2>
        <a href={url('/work')}>All work</a>
      </div>
      <ol class="work-list feature-list">
        {studies.map((entry, i) => {
          const outcome = caseHeadline(entry.data);
          return (
            <li>
              <WorkRow
                href={`/work/${entry.id}`}
                index={index(i)}
                kicker={entry.data.company}
                heading={outcome.text}
                pending={outcome.pending}
                detail={entry.data.title}
              />
            </li>
          );
        })}
      </ol>
    </section>

    <div class="front-pair">
      <section class="block" id="ai-desk" aria-labelledby="ai-heading">
        <div class="section-head">
          <h2 id="ai-heading" class="section-label">AI Desk</h2>
          <a href={url('/ai')}>All dispatches</a>
        </div>
        <ul class="ai-teaser">
          {dispatches.map((entry) => {
            const data = entry.data;
            const waiting = !(data.problem || data.principles || data.system || data.stillDecide || data.outcome);
            return (
              <li>
                <a href={url(`/ai#${entry.id}`)}>{data.title}</a>
                {waiting ? <p class="filed">Filed soon.</p> : data.problem && <p>{data.problem}</p>}
              </li>
            );
          })}
        </ul>
      </section>

      <section class="block" id="off-clock" aria-labelledby="life-heading">
        <div class="section-head">
          <h2 id="life-heading" class="section-label">Off the clock</h2>
          <a href={url('/life')}>Life</a>
        </div>
        <p class="deck">{brand.line}</p>
        {brand.filed && <p class="filed">{brand.filed}</p>}
        <ul class="teaser-slots">
          {otherLife.map((slot) => (
            <li>{slot.title}. Filed soon.</li>
          ))}
        </ul>
      </section>
    </div>

    <section class="block" id="writing" aria-labelledby="writing-heading">
      <div class="section-head">
        <h2 id="writing-heading" class="section-label">Writing</h2>
        <a href={url('/writing')}>Archive</a>
      </div>
      <ul class="writing-list archive">
        {writing.map((entry) => {
          const metric = entry.data.metric ? visibleCopy(entry.data.metric) : undefined;
          return (
            <li>
              <a href={entry.data.href} target="_blank" rel="noopener noreferrer">
                {entry.data.title}
                <span class="vh"> (opens in a new tab)</span>
              </a>
              <p class="writing-meta">{entry.data.outlet}{entry.data.date ? ` · ${entry.data.date}` : ''}</p>
              <p class="writing-summary">{entry.data.summary}</p>
              {metric && (
                <p class="writing-summary">
                  {metric.text}
                  {metric.pending && <Badge />}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </section>

    <section class="classifieds" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-label">Classifieds / Contact</h2>
      <ul class="contact-list">
        <li><a href={url(site.resumePath)}>Resume</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="vh"> (opens in a new tab)</span></a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </section>
  </div>
</Base>
