---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Text from '../components/Text.astro';
import WorkRow from '../components/WorkRow.astro';
import { SHOW_PENDING_BADGES, site } from '../data/site';
import { resolveCopy } from '../lib/copy';
import { url } from '../lib/url';
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const writing = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);

const index = (n: number) => String(n + 1).padStart(2, '0');
---
<Base>
  <div class="page">
    <section class="hero" aria-labelledby="positioning">
      <p class="eyebrow">Product manager · Chennai</p>
      <h1 id="positioning">{site.positioning}</h1>
      <p class="lede">{site.intro}</p>
      <p class="where">{site.location}</p>
      <ul class="metrics">
        {site.heroMetrics.map((metric) => (
          <li>
            <p class="metric-value">{metric.value}</p>
            <p class="metric-label">
              {metric.label}
              {metric.pending && SHOW_PENDING_BADGES && <Badge />}
            </p>
          </li>
        ))}
      </ul>
      <p class="metric-note"><Text text={site.heroMetricsNote} /></p>
      <ul class="actions">
        <li><a href={url(site.resumePath)}>Resume</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="vh"> (opens in a new tab)</span></a></li>
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </section>

    <section class="block" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading" class="section-label">Selected work</h2>
        <a href={url('/work')}>All work</a>
      </div>
      <ol class="work-list">
        {studies.map((entry, i) => {
          const outcome = resolveCopy(entry.data.outcome);
          return (
            <li>
              <WorkRow
                href={`/work/${entry.id}`}
                index={index(i)}
                kicker={entry.data.company}
                heading={outcome.text}
                pending={outcome.pending}
                detail={entry.data.title}
              />
            </li>
          );
        })}
      </ol>
    </section>

    <section class="block" aria-labelledby="how-heading">
      <h2 id="how-heading" class="section-label">How I work</h2>
      <ol class="principles">
        {site.howIWork.map((item, i) => (
          <li>
            <span class="principle-index">{index(i)}</span>
            <h3 class="principle">{item.principle}</h3>
            <p class="principle-example">{item.example}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="writing-heading">
      <div class="section-head">
        <h2 id="writing-heading" class="section-label">Writing</h2>
        <a href={url('/writing')}>All writing</a>
      </div>
      <ul class="writing-list">
        {writing.map((entry) => {
          const metric = entry.data.metric ? resolveCopy(entry.data.metric) : undefined;
          return (
            <li>
              <a href={entry.data.href} target="_blank" rel="noopener noreferrer">
                {entry.data.title}
                <span class="vh"> (opens in a new tab)</span>
              </a>
              <p class="writing-meta">{entry.data.outlet}{entry.data.date ? ` · ${entry.data.date}` : ''}</p>
              <p class="writing-summary">{entry.data.summary}</p>
              {metric && (
                <p class="writing-summary">
                  {metric.text}
                  {metric.pending && <Badge />}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </section>

    <section class="block" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-label">Contact</h2>
      <ul class="contact-list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="vh"> (opens in a new tab)</span></a></li>
        <li><a href={url(site.resumePath)}>Resume</a></li>
      </ul>
      <p class="quiet">{site.resumeNote}</p>
    </section>
  </div>
</Base>
